{
  "name": "cms-mcp-hub",
  "version": "1.0.0",
  "description": "Universal CMS connector hub — proxies Claude.ai tool calls to remote CMS MCP servers",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cms-hub": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch connectors.json --watch src src/index.js",
    "sync": "nodemon --watch connectors.json --ext json src/index.js",
    "cli": "node src/cli/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "eventsource": "^2.0.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
